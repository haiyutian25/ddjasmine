<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- 插件自主声明所需权限，构建时由 app 的 generatePluginPermissions 合并进宿主 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="MCP 插件">
        <!-- Runtime contract: entry class + description read at install -->
        <meta-data
            android:name="jasmine.plugin.entryClass"
            android:value="jasmine.sample.mcp.McpEntry" />
        <meta-data
            android:name="jasmine.plugin.description"
            android:value="完整的 Model Context Protocol 客户端：配置管理、连接、工具发现与调用" />
    </application>

</manifest>
