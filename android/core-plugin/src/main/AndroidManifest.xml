<?xml version="1.0" encoding="utf-8"?>
<!--
  Library manifest: proxy components merge into the host app automatically.
  ${applicationId} expands to the HOST's package id at merge time, so the
  provider authority and broadcast package scoping stay host-unique.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Proxy activity slots: one per launch mode, so plugin activities
             can pick standard / singleTop / singleTask / transparent without
             colliding on a single host activity. -->
        <activity
            android:name=".proxy.HostActivity"
            android:exported="false" />
        <activity
            android:name=".proxy.HostActivitySingleTop"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".proxy.HostActivitySingleTask"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".proxy.HostActivityTransparent"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Centralized static-broadcast proxy: shared system action set -->
        <receiver
            android:name=".proxy.HostReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.SCREEN_OFF" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Centralized content-provider proxy -->
        <provider
            android:name=".proxy.HostProvider"
            android:authorities="${applicationId}.plugin.proxy"
            android:exported="true" />

        <!-- Pooled proxy services: ten concurrent plugin-service slots.
             foregroundServiceType=specialUse lets plugin services call
             startForeground on Android 14+; the required subtype property
             documents the purpose. -->
        <service android:name=".proxy.HostService1" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="插件前台服务代理" />
        </service>
        <service android:name=".proxy.HostService2" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="插件前台服务代理" />
        </service>
        <service android:name=".proxy.HostService3" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="插件前台服务代理" />
        </service>
        <service android:name=".proxy.HostService4" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="插件前台服务代理" />
        </service>
        <service android:name=".proxy.HostService5" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="插件前台服务代理" />
        </service>
        <service android:name=".proxy.HostService6" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="插件前台服务代理" />
        </service>
        <service android:name=".proxy.HostService7" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="插件前台服务代理" />
        </service>
        <service android:name=".proxy.HostService8" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="插件前台服务代理" />
        </service>
        <service android:name=".proxy.HostService9" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="插件前台服务代理" />
        </service>
        <service android:name=".proxy.HostService10" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="插件前台服务代理" />
        </service>

        <!-- Isolated-process service pool: runs services of plugins placed in
             the isolated process, so bind/start cross the boundary natively. -->
        <service android:name=".proxy.IsolatedHostService1" android:exported="false"
            android:process=":plugin_isolated"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="插件隔离进程服务代理" />
        </service>
        <service android:name=".proxy.IsolatedHostService2" android:exported="false"
            android:process=":plugin_isolated"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="插件隔离进程服务代理" />
        </service>
        <service android:name=".proxy.IsolatedHostService3" android:exported="false"
            android:process=":plugin_isolated"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="插件隔离进程服务代理" />
        </service>
        <service android:name=".proxy.IsolatedHostService4" android:exported="false"
            android:process=":plugin_isolated"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="插件隔离进程服务代理" />
        </service>

        <!-- Default authorization dialog (hosts can replace the handler) -->
        <activity
            android:name=".auth.PluginAuthorizationActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Isolated-process host for heavy-native plugins (MNN, Proot):
             a crash or memory pressure here never drags the host down. -->
        <service
            android:name=".process.IsolatedPluginProcessService"
            android:exported="false"
            android:process=":plugin_isolated" />
    </application>

</manifest>
